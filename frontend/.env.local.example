NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_STACKS_NETWORK=testnet

# Send pipeline network selection - all default to testnet. Do NOT set
# any of these to "mainnet" until you've run a full send/receive/
# fee-too-low/insufficient-balance/network-down pass on testnet for
# that specific chain. See SEND_TESTING.md before flipping any of these.
NEXT_PUBLIC_BITCOIN_NETWORK=testnet
NEXT_PUBLIC_ETHEREUM_NETWORK=testnet

# Required for ETH sends on mainnet (e.g. an Alchemy/Infura HTTPS URL).
# Testnet (Sepolia) falls back to a public RPC if left blank, so it
# works out of the box - mainnet has no default, on purpose.
NEXT_PUBLIC_ETHEREUM_RPC_URL=

# Deprecated: the Escrow and Yield Vault contracts/UI have been removed
# from the app (Escrow -> BNS Names, Yield Manager -> Stacking Monitor).
# The Clarity contracts still exist under contracts/ if you want to
# redeploy and wire them back up yourself, but nothing in the frontend
# reads these anymore.
NEXT_PUBLIC_ESCROW_CONTRACT=
NEXT_PUBLIC_YIELD_VAULT_CONTRACT=

NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=StackSuite_bot

# Free from https://cloud.reown.com (formerly WalletConnect Cloud).
# Without this, "Connect wallet" only detects browser-extension wallets
# and a wallet's own in-app browser - it will NOT find an installed
# mobile wallet app from a normal mobile browser tab. Setting this
# enables a real QR/deep-link connection path for mobile wallets
# (Xverse supports this on iOS and Android).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MONGODB_URI=mongodb://localhost:27017/stacksuite
