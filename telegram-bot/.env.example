# Same bot token as backend/.env - both services must use the identical token.
TELEGRAM_BOT_TOKEN=

# Where this bot reaches the StackSuite backend's API. When deployed
# separately (e.g. Railway/Render), point this at the backend's public URL.
BACKEND_URL=http://localhost:4000

# Must match TELEGRAM_BOT_SHARED_SECRET in backend/.env exactly - this is
# the bearer secret the backend checks on requests coming from this bot.
TELEGRAM_BOT_SHARED_SECRET=change-me

# Used only for the Redis pub/sub subscriber that delivers chainhook and
# price-alert notifications - same Redis instance as backend/.env.
REDIS_URL=redis://localhost:6379
